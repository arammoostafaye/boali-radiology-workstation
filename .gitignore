# Skills directory
/skills/

# ---- Boali: MedalPACS bridge runtime artifacts -------------------------
# 12-hour persisted login sessions + downloaded DICOM study packages
# (machine-local, never part of the shipped product)
.boali-medal-sessions.json
.boali-medal-cache/

# ---- Boali: runtime / machine-local artifacts --------------------------
# agent session artifacts
/tool-results/
# user uploads (transient; extracted assets live in public/)
/upload/
/download/
# sandbox infrastructure (not part of the shipped product)
/.zscripts/
/examples/
/tests/
/scripts/
/Caddyfile
# runtime databases (auto-created on first run)
mini-services/boali-pacs/pacs.db
db/*.db
# Python venv created by windows/START-BOALI.bat
.venv/
venv/
__pycache__/
*.pyc

# ---- Boali: giant model weights (417 MB each, over GitHub's 100 MB limit)
# Stored as <100 MB chunks in weights/chunks/ (all bytes ship with the repo).
# These assembled files are rebuilt locally by windows/START-BOALI.bat or
# tools/assemble_weights.py and never committed.
mini-services/boali-engine/weights/bone_suppression.ts
mini-services/boali-engine/weights/lung_component_suppression.ts

# ---- Boali: bundled Windows runtime wheels ------------------------------
# torch (109 MB) is over GitHub's 100 MiB per-file limit, so it is shipped
# split in runtime/wheels/chunks/ and assembled locally by
# windows/START-BOALI.bat / tools/assemble_runtime.py (sha256-verified
# against runtime/MANIFEST.txt). The assembled wheel is never committed.
# (torchvision-*.whl does NOT match this pattern and stays tracked.)
runtime/wheels/torch-*.whl
# bundled runtimes extracted on first launch (the .zip sources stay tracked)
runtime/python/
runtime/node/
runtime/tmp/
# Boali service logs + pid records (written by tools/boali_launch.py at runtime)
/logs/

# in-app updater runtime state
/.update/
